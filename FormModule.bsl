// Модуль управляемой формы внешней обработки.
// Проверка и предварительная загрузка прайс-листа.
// Формат строки: Наименование;Цена.
// Обработка не изменяет данные информационной базы.

#Область КомандыФормы

&НаКлиенте
Процедура ЗаполнитьПример(Команда)

    ИсходныйТекст = "Чай;120,50"
        + Символы.ПС + "Кофе;85"
        + Символы.ПС + "Какао;249.99";

    Товары.Очистить();
    ЖурналПроверки = "Пример заполнен. Нажмите «Загрузить прайс».";

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПрайс(Команда)

    ЗагрузитьПрайсНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СервернаяОбработка

&НаСервере
Процедура ЗагрузитьПрайсНаСервере()

    Результат = РазобратьПрайс(ИсходныйТекст);

    // Удаляем предыдущий результат, чтобы при ошибке
    // пользователь не принял старые данные за новые.
    Товары.Очистить();

    Если Результат.Ошибки.Количество() > 0 Тогда

        ЖурналПроверки = "Загрузка отменена. Исправьте ошибки:"
            + Символы.ПС
            + СтрСоединить(Результат.Ошибки, Символы.ПС);

        Возврат;

    КонецЕсли;

    ЗначениеВРеквизитФормы(Результат.Таблица, "Товары");

    ЖурналПроверки = "Загружено позиций: "
        + Формат(Результат.Таблица.Количество(), "ЧГ=0")
        + ". Данные в базу не записывались.";

КонецПроцедуры

&НаСервереБезКонтекста
Функция РазобратьПрайс(ТекстПрайса)

    Таблица = СоздатьТаблицуТоваров();
    Ошибки = Новый Массив;

    Результат = Новый Структура(
        "Таблица,Ошибки",
        Таблица,
        Ошибки);

    Если СтрДлина(ТекстПрайса) > 50000 Тогда

        Ошибки.Добавить(
            "Текст превышает ограничение 50 000 символов.");

        Возврат Результат;

    КонецЕсли;

    // Нормализуем переводы строк Windows, Linux и macOS.
    ТекстПрайса = СтрЗаменить(
        ТекстПрайса,
        Символы.ВК + Символы.ПС,
        Символы.ПС);

    ТекстПрайса = СтрЗаменить(
        ТекстПрайса,
        Символы.ВК,
        Символы.ПС);

    СтрокиПрайса = СтрРазделить(
        ТекстПрайса,
        Символы.ПС,
        Истина);

    Если СтрокиПрайса.Количество() > 1000 Тогда

        Ошибки.Добавить(
            "Допускается не более 1 000 строк, включая пустые.");

        Возврат Результат;

    КонецЕсли;

    НайденныеНаименования = Новый Соответствие;
    НомерСтроки = 0;

    Для Каждого СтрокаПрайса Из СтрокиПрайса Цикл

        НомерСтроки = НомерСтроки + 1;

        Если ПустаяСтрока(СтрокаПрайса) Тогда
            Продолжить;
        КонецЕсли;

        ПрефиксОшибки = "Строка "
            + Формат(НомерСтроки, "ЧГ=0")
            + ": ";

        Поля = СтрРазделить(СтрокаПрайса, ";", Истина);

        Если Поля.Количество() <> 2 Тогда

            Ошибки.Добавить(
                ПрефиксОшибки
                + "ожидается формат Наименование;Цена.");

            Продолжить;

        КонецЕсли;

        Наименование = СокрЛП(Поля[0]);

        Если ПустаяСтрока(Наименование)
            Или СтрДлина(Наименование) > 150 Тогда

            Ошибки.Добавить(
                ПрефиксОшибки
                + "наименование должно содержать от 1 до 150 символов.");

            Продолжить;

        КонецЕсли;

        // Ищем повторы без учета регистра и внешних пробелов.
        КлючНаименования = ВРег(Наименование);

        ПерваяСтрока = НайденныеНаименования.Получить(
            КлючНаименования);

        Если ПерваяСтрока <> Неопределено Тогда

            Ошибки.Добавить(
                ПрефиксОшибки
                + "повтор наименования из строки "
                + Формат(ПерваяСтрока, "ЧГ=0")
                + ".");

            Продолжить;

        КонецЕсли;

        НайденныеНаименования.Вставить(
            КлючНаименования,
            НомерСтроки);

        Цена = РазобратьЦену(Поля[1]);

        Если Цена = Неопределено Тогда

            Ошибки.Добавить(
                ПрефиксОшибки
                + "некорректная цена. Пример: 120,50. "
                + "Допускается неотрицательное число "
                + "с двумя знаками после разделителя.");

            Продолжить;

        КонецЕсли;

        СтрокаТаблицы = Таблица.Добавить();
        СтрокаТаблицы.НомерСтрокиИсточника = НомерСтроки;
        СтрокаТаблицы.Наименование = Наименование;
        СтрокаТаблицы.Цена = Цена;

    КонецЦикла;

    Если Таблица.Количество() = 0
        И Ошибки.Количество() = 0 Тогда

        Ошибки.Добавить("Нет позиций для загрузки.");

    КонецЕсли;

    Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция СоздатьТаблицуТоваров()

    Таблица = Новый ТаблицаЗначений;

    ТипНомераСтроки = Новый ОписаниеТипов(
        "Число",
        Новый КвалификаторыЧисла(4, 0));

    ТипНаименования = Новый ОписаниеТипов(
        "Строка",
        ,
        Новый КвалификаторыСтроки(150));

    ТипЦены = Новый ОписаниеТипов(
        "Число",
        Новый КвалификаторыЧисла(12, 2));

    Таблица.Колонки.Добавить(
        "НомерСтрокиИсточника",
        ТипНомераСтроки);

    Таблица.Колонки.Добавить(
        "Наименование",
        ТипНаименования);

    Таблица.Колонки.Добавить(
        "Цена",
        ТипЦены);

    Возврат Таблица;

КонецФункции

&НаСервереБезКонтекста
Функция РазобратьЦену(ТекстЦены)

    // Проверяем формат до преобразования в число,
    // чтобы исключить округление лишних дробных знаков.
    ТекстЦены = СтрЗаменить(СокрЛП(ТекстЦены), ".", ",");

    Если ПустаяСтрока(ТекстЦены) Тогда
        Возврат Неопределено;
    КонецЕсли;

    ЧастиЦены = СтрРазделить(ТекстЦены, ",", Истина);

    Если ЧастиЦены.Количество() > 2 Тогда
        Возврат Неопределено;
    КонецЕсли;

    ЦелаяЧасть = ЧастиЦены[0];

    Если СтрДлина(ЦелаяЧасть) = 0
        Или СтрДлина(ЦелаяЧасть) > 10 Тогда

        Возврат Неопределено;

    КонецЕсли;

    Если Не ТолькоЦифры(ЦелаяЧасть) Тогда
        Возврат Неопределено;
    КонецЕсли;

    ДробнаяЧасть = "00";

    Если ЧастиЦены.Количество() = 2 Тогда

        ДробнаяЧасть = ЧастиЦены[1];

        Если СтрДлина(ДробнаяЧасть) = 0
            Или СтрДлина(ДробнаяЧасть) > 2 Тогда

            Возврат Неопределено;

        КонецЕсли;

        Если Не ТолькоЦифры(ДробнаяЧасть) Тогда
            Возврат Неопределено;
        КонецЕсли;

        ДробнаяЧасть = Лев(ДробнаяЧасть + "0", 2);

    КонецЕсли;

    // Преобразуем только целые числа, поэтому результат
    // не зависит от регионального десятичного разделителя.
    Возврат Число(ЦелаяЧасть)
        + Число(ДробнаяЧасть) / 100;

КонецФункции

&НаСервереБезКонтекста
Функция ТолькоЦифры(ПроверяемыйТекст)

    Для Индекс = 1 По СтрДлина(ПроверяемыйТекст) Цикл

        ТекущийСимвол = Сред(ПроверяемыйТекст, Индекс, 1);

        Если СтрНайти("0123456789", ТекущийСимвол) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;

    КонецЦикла;

    Возврат Истина;

КонецФункции

#КонецОбласти
